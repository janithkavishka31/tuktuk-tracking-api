generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  POLICE
}

model User {
  id              String         @id @default(cuid())
  fullName        String
  email           String         @unique
  password        String
  role            UserRole
  policeStationId String?
  policeStation   PoliceStation? @relation(fields: [policeStationId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([policeStationId])
}

model Province {
  id        String    @id @default(cuid())
  name      String    @unique
  districts District[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model District {
  id             String           @id @default(cuid())
  name           String
  provinceId     String
  province       Province         @relation(fields: [provinceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  policeStations PoliceStation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provinceId, name])
  @@index([provinceId])
}

model PoliceStation {
  id         String   @id @default(cuid())
  name       String
  districtId String
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  users      User[]
  tuktuks    TukTuk[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([districtId, name])
  @@index([districtId])
}

model TukTuk {
  id              String        @id @default(cuid())
  registrationNo  String        @unique
  policeStationId String
  policeStation   PoliceStation @relation(fields: [policeStationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  locations       Location[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([policeStationId])
}

model Location {
  id        String   @id @default(cuid())
  tuktukId  String
  tuktuk    TukTuk   @relation(fields: [tuktukId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  latitude  Float
  longitude Float
  speed     Float    @default(0)
  heading   Float    @default(0)
  accuracy  Float    @default(0)
  altitude  Float    @default(0)
  createdAt DateTime @default(now())

  @@index([tuktukId])
  @@index([createdAt])
}
