generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  PROVINCE_ADMIN
  DISTRICT_ADMIN
  STATION_ADMIN
  POLICE
}

model User {
  id         String   @id @default(cuid())
  name       String
  email      String   @unique
  password   String
  role       UserRole
  provinceId String?
  districtId String?
  stationId  String?

  province Province?       @relation(fields: [provinceId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  district District?       @relation(fields: [districtId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  station  PoliceStation?  @relation(fields: [stationId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([provinceId])
  @@index([districtId])
  @@index([stationId])
}

model Province {
  id        String     @id @default(cuid())
  name      String     @unique
  districts District[]
  users     User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model District {
  id             String           @id @default(cuid())
  name           String
  provinceId     String
  province       Province         @relation(fields: [provinceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  policeStations PoliceStation[]
  users          User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provinceId, name])
  @@index([provinceId])
}

model PoliceStation {
  id         String   @id @default(cuid())
  name       String
  districtId String
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  users      User[]
  tuktuks    TukTuk[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([districtId, name])
  @@index([districtId])
}

model TukTuk {
  id              String        @id @default(cuid())
  registrationNo  String        @unique
  policeStationId String
  policeStation   PoliceStation @relation(fields: [policeStationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  locations       Location[]
  devices         Device[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([policeStationId])
}

model Device {
  id         String    @id @default(cuid())
  tuktukId   String
  tuktuk     TukTuk    @relation(fields: [tuktukId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  apiKeyHash String
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([tuktukId])
}

model Location {
  id        String   @id @default(cuid())
  tuktukId  String
  tuktuk    TukTuk   @relation(fields: [tuktukId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  latitude  Float
  longitude Float
  speed     Float    @default(0)
  heading   Float    @default(0)
  accuracy  Float    @default(0)
  altitude  Float    @default(0)
  createdAt DateTime @default(now())

  @@index([tuktukId])
  @@index([createdAt])
}
